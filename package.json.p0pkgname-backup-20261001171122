{
  "name": "@snow-the/dsh-session-handoff",
  "version": "0.18.13",
  "type": "module",
  "main": "./lib/index.js",
  "description": "Session handoff & context management for DeepSeek Harness: structured handoff documents (export/resume/status), active context pruning (acp_* tools + pressure banner), session management (trash/restore/purge), model routes for one model across vendors/plans, and optional OpenViking memory / archify diagram integration. Core is zero-dependency (official compaction API + node builtins); memory/diagram enhance when detected.",
  "files": [
    "dist",
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": [
        "0.2.0-rc.1",
        "0.2.0-rc.2"
      ],
      "verifiedAgainst": "0.2.0-rc.2"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session",
    "handoff",
    "context",
    "compaction",
    "memory",
    "model-routes"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snow-The/dsh-session-handoff.git"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --import ./test/register-stubs.mjs --test \"test/*.test.mjs\"",
    "fuzz": "node test/fuzz-reader.mjs --iters=400"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-home-paths": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-session-persistence-jsonl/src/zstd": ">=0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1"
  }
}
